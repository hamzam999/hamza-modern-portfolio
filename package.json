{
  "name": "mohammad-hamza-senior-frontend-developer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "budgets": "node scripts/check-budgets.mjs",
    "fonts:jp": "node scripts/subset-jp-fonts.mjs && node scripts/kanji-paths.mjs",
    "grain": "node scripts/build-grain.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:e2e": "vite build --mode e2e && vite build --mode e2e --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "shots": "playwright test tests/e2e/shots.spec.ts"
  },
  "dependencies": {
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "4.3.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fontaine": "1.1.0",
    "opentype.js": "2.0.0",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "5.1.2"
  }
}
